# LLM Configuration (DeepSeek, OpenAI-compatible API)
# Used by the deep agent's own conversational front-end.
DEEP_SEEK_API_KEY=your_deepseek_api_key_here
DEEP_SEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# Retry and fallback policy for every LLM call (src/shared/llm/client.py).
# LLM_MAX_RETRIES is per model, not per call: each provider in the fallback
# chain gets its own budget. Backoff is exponential with jitter, capped at
# LLM_RETRY_MAX_DELAY, and honors a provider's Retry-After.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0

# Providers (by name, from config.PROVIDERS) tried after the primary model
# when it runs out of retries or cannot serve the request at all. Leave
# empty to require the primary model. Typesafe is not eligible: it does not
# speak the chat-completions API.
LLM_FALLBACK_PROVIDERS=openai

# Jury Configuration -- one LLM provider per juror (src/jury/evaluators.py).
# DeepSeek juror reuses DEEP_SEEK_API_KEY / DEEP_SEEK_BASE_URL above.
LLM_MODEL_DEEP_SEEK=deepseek-v4-pro

OPEN_AI_API_KEY=your_openai_api_key_here
LLM_MODEL_OPEN_AI=gpt-4o
OPEN_AI_BASE_URL=https://api.openai.com/v1

TYPESAFE_API_KEY=your_typesafe_api_key_here
LLM_MODEL_TYPESAFE=your_typesafe_model_here
TYPESAFE_BASE_URL=your_typesafe_base_url_here

# PostgreSQL Configuration (used for persistent memory / history)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=adapteval_agent

# Host-side port docker-compose exposes Postgres on (change if 5432 is
# already taken by a local Postgres install). Not used inside the
# container network, where the app always talks to postgres:5432.
POSTGRES_HOST_PORT=5433

# Set to "true" to persist evaluation/metrics history in PostgreSQL
# instead of keeping it only in memory. When running via docker-compose
# this is set automatically to "true" and DB_HOST is set to "postgres".
USE_POSTGRES_MEMORY=False

# O catálogo de rubricas (tabela evaluation_criteria) é lido do Postgres em
# toda avaliação, por isso vem ligado por default. Com "false" -- ou sem
# banco acessível -- o catálogo roda em memória: as mesmas rubricas padrão
# são servidas, mas critérios criados durante a execução são perdidos no
# fim dela.
USE_POSTGRES_CRITERIA=True

# Vector DB Configuration (for cache, optional)
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6379
VECTOR_DB_NAME=adapteval_vectors

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/adapteval.log

# Processing Configuration
BATCH_SIZE=32
NUM_WORKERS=4
ASYNC_PROCESSING=False

# Evaluation Configuration
CONFIDENCE_THRESHOLD=0.7
MIN_EVALUATORS=3
USE_HUMAN_IN_THE_LOOP=True

# Memory Manager Configuration
CACHE_SIZE_MB=1024
CACHE_TTL_HOURS=24
ENABLE_CALIBRATION=True
